<Page x:Class="HammerMtheater.Pages.OperatorDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#121519" BorderBrush="#252A31" BorderThickness="0,0,1,0">
            <Grid>
                <StackPanel Margin="0,40">
                    <materialDesign:PackIcon Kind="ShieldAccount" Foreground="#00C896" 
                                             Width="48" Height="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="OPERATOR CORE" Foreground="White" FontWeight="Black" 
                               FontSize="14"
                               HorizontalAlignment="Center" Margin="0,15,0,50"/>

                    <StackPanel Margin="15,0">
                        <RadioButton x:Name="BtnTheaters" Click="NavTheaters_Click" IsChecked="True"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Height="50" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Theater" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THEATERS" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnMovies" Click="NavMovies_Click"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Height="50" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MovieOpenPlay" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MOVIES" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnUsers" Click="NavUsers_Click"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Height="50" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="USERS" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="BtnTickets" Click="NavTickets_Click"
                                     Style="{StaticResource MaterialDesignTabRadioButton}"
                                     Foreground="White" Height="50" Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TicketConfirmation" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <TextBlock Text="TICKET LOGS" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <Button VerticalAlignment="Bottom" Margin="20,40" 
                        Content="SYSTEM LOGOUT" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="#555E67" FontSize="11" FontWeight="Bold"
                        Click="Logout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,35">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ViewTitle" Text="Theater Management" FontSize="36" 
                               FontWeight="Black" Foreground="White" />
                    <TextBlock Text="Modify infrastructure, halls, and seating capacities" 
                               Foreground="#555E67" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Bottom">
                    <materialDesign:ColorZone Mode="Standard" CornerRadius="8" Padding="10,2" 
                                              Background="#16191E" BorderBrush="#252A31" BorderThickness="1"
                                              Width="250" Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Search" Foreground="#555E67" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" 
                                     materialDesign:HintAssist.Hint="Search records..." 
                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                     BorderThickness="0" Foreground="White" VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </materialDesign:ColorZone>

                    <Button Click="RefreshButton_Click" ToolTip="Refresh Data"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="#9BA1A6" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>

                    <Button Content="INSERT ENTRY" Click="InsertItem_Click" 
                            Background="#00C896" Foreground="#0B0E11" FontWeight="Black"
                            BorderThickness="0" Height="45" Width="150"
                            materialDesign:ButtonAssist.CornerRadius="8">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#00C896" Opacity="0.2" ShadowDepth="0"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </DockPanel>

            <materialDesign:Card Grid.Row="2" Background="#16191E" UniformCornerRadius="15" 
                                 materialDesign:ElevationAssist.Elevation="Dp0" 
                                 BorderBrush="#252A31" BorderThickness="1">
                <Grid>
                    <DataGrid x:Name="MainDataGrid" 
                              Background="Transparent" Foreground="White" RowBackground="Transparent"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#0DFFFFFF"
                              AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="55" HeadersVisibility="Column"
                              SelectionUnit="FullRow" SelectionMode="Single">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1C2128"/>
                                <Setter Property="Foreground" Value="#9BA1A6"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="Padding" Value="20,15"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#252A31"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="20,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1A00C896"/>
                                        <Setter Property="Foreground" Value="#00C896"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CONTROL" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                    Click="UpdateItem_Click" Foreground="#2196F3" Width="34" Height="34">
                                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                    Click="DeleteItem_Click" Foreground="#FF5252" Width="34" Height="34" Margin="5,0,0,0">
                                                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid x:Name="LoadingSpinner" Visibility="Collapsed" Background="#CC16191E">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Value="0" IsIndeterminate="True"
                                         Width="40" Height="40" Foreground="#00C896" />
                            <TextBlock Text="SYNCING CORE..." Foreground="#00C896" FontWeight="Black" 
                                       FontSize="10" Margin="0,15,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>