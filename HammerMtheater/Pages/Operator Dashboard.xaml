<Page x:Class="HammerMtheater.Pages.OperatorDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#050505">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#111" BorderBrush="#222" BorderThickness="0,0,1,0">
            <StackPanel Margin="20,40">
                <materialDesign:PackIcon Kind="ShieldAccount" Foreground="#E50914" 
                                         Width="40" Height="40" HorizontalAlignment="Center"/>
                <TextBlock Text="OPERATOR" Foreground="White" FontWeight="Black" 
                           HorizontalAlignment="Center" Margin="0,10,0,40"/>

                <StackPanel Margin="20,40">
                    
                    <Button x:Name="BtnTheaters" Content="Theaters" Click="NavTheaters_Click" Margin="0,5"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" HorizontalContentAlignment="Left" Height="45"/>

                    <Button x:Name="BtnMovies" Content="Movies" Click="NavMovies_Click" Margin="0,5"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" HorizontalContentAlignment="Left" Height="45"/>

                    <Button x:Name="BtnUsers" Content="Users" Click="NavUsers_Click" Margin="0,5"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" HorizontalContentAlignment="Left" Height="45"/>

                    <Button x:Name="BtnTickets" Content="Tickets" Click="NavTickets_Click" Margin="0,5"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" HorizontalContentAlignment="Left" Height="45"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ViewTitle" Text="Theater Management" FontSize="28" 
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="INSERT NEW" Click="InsertItem_Click" DockPanel.Dock="Right"
                        Background="#E50914" BorderThickness="0" Height="35" Width="120"/>
            </DockPanel>
            <Button Content="REFRESH DATA" Click="RefreshButton_Click" 
        Background="#333" Foreground="White" Width="120" Height="30" Margin="10"/>
            <DataGrid Grid.Row="1" x:Name="MainDataGrid" Margin="0,99,0,0"
                      Background="Transparent" Foreground="White" RowBackground="#161616"
                      AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="EDIT" Click="UpdateItem_Click" Margin="2" 
                                            Background="#2196F3" BorderThickness="0" Height="25"/>
                                    <Button Content="REMOVE" Click="DeleteItem_Click" Margin="2" 
                                            Background="#D32F2F" BorderThickness="0" Height="25"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>