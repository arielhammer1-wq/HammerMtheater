<Page x:Class="HammerMtheater.Pages.TicketSummary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050505">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="FINAL STEP" 
                       Foreground="#E50914" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>
            <TextBlock Text="Booking Summary"
                       FontSize="32"
                       FontWeight="ExtraBold"
                       Foreground="White"/>
        </StackPanel>

        <Border Grid.Row="1" 
                MaxWidth="450" 
                VerticalAlignment="Top" 
                Background="#161616" 
                CornerRadius="15" 
                BorderBrush="#333" 
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="MOVIE" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="MovieText"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,25"/>

                <Separator Background="#222" Margin="0,0,0,25"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="THEATER" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="TheaterText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="HALL" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="HallText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="SEATS" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="SeatsText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="TOTAL PRICE" Foreground="#555" FontSize="10" FontWeight="Bold"/>
                        <TextBlock x:Name="PriceText" Foreground="#E50914" FontSize="20" FontWeight="ExtraBold"/>
                    </StackPanel>
                </UniformGrid>

                <Rectangle Height="1" Fill="Transparent" Margin="0,30,0,30" Stroke="#333" StrokeDashArray="4 2"/>

                <TextBlock Text="Show this digital ticket at the entrance." 
                           Foreground="#444" 
                           FontSize="11" 
                           HorizontalAlignment="Center" 
                           FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Go Back"
                    Width="140"
                    Height="50"
                    Background="Transparent"
                    Foreground="#888"
                    BorderBrush="#333"
                    BorderThickness="1"
                    Margin="0,0,15,0"
                    Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="CONFIRM &amp; PAY"
                    Width="220"
                    Height="50"
                    Background="#E50914"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Confirm_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#E50914" Opacity="0.3" ShadowDepth="0"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Page>