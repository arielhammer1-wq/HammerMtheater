<Page x:Class="HammerMtheater.Pages.TicketSummary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="FINAL CONFIRMATION" 
                       Foreground="#00C896" 
                       FontSize="11" 
                       FontWeight="Black" 
                       
                       Margin="0,0,0,8"/>
            <TextBlock Text="Booking Summary"
                       FontSize="56"
                       FontWeight="Black"
                       Foreground="White"
                       />
        </StackPanel>

        <Border Grid.Row="1" 
                MaxWidth="500" 
                VerticalAlignment="Top" 
                Background="#16191E" 
                CornerRadius="24" 
                BorderBrush="#252A31" 
                BorderThickness="1"
                Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.4" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="SELECTED MOVIE" Foreground="#555E67" FontSize="10" FontWeight="Black" Margin="0,0,0,8"/>
                <TextBlock x:Name="MovieText"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Black"
                           TextWrapping="Wrap"
                           
                           
                           Margin="0,0,0,30"/>

                <Rectangle Height="1" Fill="Transparent" Margin="0,0,0,30" Stroke="#252A31" StrokeDashArray="4 4"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="CINEMA" Foreground="#555E67" FontSize="10" FontWeight="Black"  />
                        <TextBlock x:Name="TheaterText" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="AUDITORIUM" Foreground="#555E67" FontSize="10" FontWeight="Black" />
                        <TextBlock x:Name="HallText" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="RESERVED SEATS" Foreground="#555E67" FontSize="10" FontWeight="Black"  />
                        <TextBlock x:Name="SeatsText" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="TOTAL AMOUNT" Foreground="#555E67" FontSize="10" FontWeight="Black" />
                        <TextBlock x:Name="PriceText" Foreground="#00C896" FontSize="26" FontWeight="Black" Margin="0,2,0,0"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="#3F4752" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Present this digital stub at the hall entrance." 
                               Foreground="#555E67" 
                               FontSize="12" 
                               FontWeight="Medium"
                               FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="GO BACK"
                    Width="160"
                    Height="55"
                    Background="Transparent"
                    Foreground="#9BA1A6"
                    BorderBrush="#252A31"
                    BorderThickness="1"
                    Margin="0,0,20,0"
                    materialDesign:ButtonAssist.CornerRadius="12"
                    FontWeight="Black"
                    FontSize="12"
                    Click="Back_Click"/>

            <Button Width="280"
                    Height="55"
                    Background="#00C896"
                    Foreground="#0B0E11"
                    FontWeight="Black"
                    FontSize="14"
                    materialDesign:ButtonAssist.CornerRadius="12"
                    Click="Confirm_Click">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#00C896" Opacity="0.3" ShadowDepth="0"/>
                </Button.Effect>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CreditCardCheckOutline" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CONFIRM &amp; SECURE TICKET" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>