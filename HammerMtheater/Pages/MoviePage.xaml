<Page x:Class="HammerMtheater.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:HammerMtheater.UserControls"
      Background="#0F0F0F">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <ItemsControl ItemsSource="{Binding Genres}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <StackPanel Margin="0,0,0,30">

                        <!-- GENRE TITLE -->
                        <TextBlock Text="{Binding GenreName}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="12,0,0,10"/>

                        <!-- HORIZONTAL SCROLL -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      IsHitTestVisible="True">

                            <ItemsControl ItemsSource="{Binding Movies}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:MovieCard/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>

                    </StackPanel>

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </ScrollViewer>
</Page>
