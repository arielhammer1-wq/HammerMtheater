<Page x:Class="HammerMtheater.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:HammerMtheater.UserControls"
      Background="#0B0E11">

    <Grid>
        <Image Source="pack://siteoforigin:,,,/Assets/background_static.jpg" 
               Stretch="UniformToFill" 
               Opacity="0.4">
            <Image.Effect>
                <BlurEffect Radius="40"/>
            </Image.Effect>
        </Image>

        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FF0B0E11" Offset="0"/>
                    <GradientStop Color="#CC0B0E11" Offset="0.4"/>
                    <GradientStop Color="#FF0B0E11" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Canvas IsHitTestVisible="False">
            <Ellipse Width="900" Height="900" Fill="#1000C896" Margin="-400,-400,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="150"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid Margin="60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,50">
                <TextBlock Text="CATALOG EXPLORER" Foreground="#00C896" FontSize="11" FontWeight="Black"  Margin="25,0,0,12" />

                <materialDesign:Card Background="#1AFFFFFF" UniformCornerRadius="30" 
                                     BorderBrush="#252A31" BorderThickness="1"
                                     MaxWidth="700" HorizontalAlignment="Left" Margin="10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp0">
                    <Grid>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="#9BA1A6" VerticalAlignment="Center" Margin="25,0,0,0" Width="24" Height="24"/>
                        <TextBox x:Name="SearchBox"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="White" Padding="65,18,30,18"
                                 FontSize="16" CaretBrush="#00C896"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Search movies, genres, or directors..."
                                 materialDesign:HintAssist.Foreground="#555E67"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>

            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          PanningMode="Both"
                          materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True">

                <ItemsControl ItemsSource="{Binding Genres}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,60">
                                <StackPanel Orientation="Horizontal" Margin="15,0,0,25">
                                    <Rectangle Width="4" Height="28" Fill="#00C896" Margin="0,0,18,0" RadiusX="2" RadiusY="2"/>
                                    <TextBlock Text="{Binding GenreName}"
                                               FontSize="36" FontWeight="Black"
                                               Foreground="White" VerticalAlignment="Center"
                                               />
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                              VerticalScrollBarVisibility="Disabled"
                                              materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding Movies}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="12,0,12,30">
                                                    <controls:MovieCard Cursor="Hand" Width="220" Height="330"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>