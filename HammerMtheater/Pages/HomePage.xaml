<Page x:Class="HammerMtheater.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <DockPanel Margin="0,0,0,30">
            <!--<Button Content="← Back"
                    Width="90"
                    Height="35"
                    Background="#1F1F1F"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Back_Click"/>-->

            <TextBlock Text="Hammer Cinema"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- MAIN CONTENT -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center">

            <Border Width="260" Height="150"
                    Background="#1E1E1E"
                    CornerRadius="15"
                    Margin="15"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🎬 Movies"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Browse all movies"
                               Foreground="Gray"
                               Margin="0,5,0,10"/>
                    <Button Content="Open"
                            Height="35"
                            Background="#E50914"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Movies_Click"/>
                </StackPanel>
            </Border>

            <Border Width="260" Height="150"
                    Background="#1E1E1E"
                    CornerRadius="15"
                    Margin="15"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🎟 Tickets"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Your bookings"
                               Foreground="Gray"
                               Margin="0,5,0,10"/>
                    <Button Content="Coming Soon"
                            Height="35"
                            Background="#333"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>

        </WrapPanel>
    </Grid>
</Page>
