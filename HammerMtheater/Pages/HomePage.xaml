<Page x:Class="HammerMtheater.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Foreground="White">

    <Grid>
        <MediaElement x:Name="BackgroundVideo"
                  LoadedBehavior="Manual"
                  UnloadedBehavior="Stop"
                  Stretch="UniformToFill"
                  IsMuted="True"
                  MediaEnded="BackgroundVideo_MediaEnded"/>

        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="#22000000" Offset="0.6"/>
                    <GradientStop Color="#AA000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="80,60">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="HAMMER" Foreground="#E50914" FontSize="36" FontWeight="Black"/>
                    <TextBlock Text="PREMIUM CINEMAS" Foreground="#AAA" FontSize="12" FontWeight="Bold"  Margin="2,-5,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Support" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,30,0" Cursor="Hand"/>
                    <materialDesign:Card UniformCornerRadius="25" Width="50" Height="50" Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                        <TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                    </materialDesign:Card>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
                    <Border Background="#E50914" HorizontalAlignment="Left" Padding="14,5" CornerRadius="4" Margin="0,0,0,25">
                        <TextBlock Text="NOW IN THEATERS" FontSize="12" FontWeight="Black" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Experience Cinema" FontSize="86" FontWeight="Black" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Like Never Before." FontSize="86" FontWeight="Black" Foreground="#E50914" Margin="0,-15,0,30"/>
                    <TextBlock Text="Book the latest blockbusters in 4K Laser Projection. Your ultimate movie night starts right here." 
                           Foreground="#DDD" FontSize="20" TextWrapping="Wrap" MaxWidth="600" LineHeight="30"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="450" HorizontalAlignment="Right">

                    <Button Click="Movies_Click" Background="Transparent" BorderThickness="0" Height="180" Margin="0,0,0,30" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CardBorder" Background="#22FFFFFF" CornerRadius="24" BorderBrush="#33FFFFFF" BorderThickness="1.5" Padding="35">
                                    <Border.Effect>
                                        <BlurEffect Radius="0" x:Name="Blur"/>
                                    </Border.Effect>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="EXPLORE MOVIES" FontSize="14" FontWeight="Black" Foreground="#E50914" Margin="0,0,0,10"/>
                                            <TextBlock Text="Browse Showtimes" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                        <materialDesign:PackIcon Kind="ArrowRight" HorizontalAlignment="Right" VerticalAlignment="Center" Width="35" Height="35" Foreground="White" x:Name="Icon"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#44FFFFFF"/>
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#E50914"/>
                                        <Setter TargetName="Icon" Property="Margin" Value="0,0,10,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="My_Tickets_Click" Background="Transparent" BorderThickness="0" Height="180" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CardBorder" Background="#11FFFFFF" CornerRadius="24" BorderBrush="#22FFFFFF" BorderThickness="1.5" Padding="35">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="USER PANEL" FontSize="14" FontWeight="Black" Foreground="#AAA" Margin="0,0,0,10"/>
                                            <TextBlock Text="My Tickets" FontSize="28" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                        <materialDesign:PackIcon Kind="TicketConfirmation" HorizontalAlignment="Right" VerticalAlignment="Center" Width="35" Height="35" Foreground="#AAA" x:Name="Icon"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardBorder" Property="Background" Value="#33FFFFFF"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>