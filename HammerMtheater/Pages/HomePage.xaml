<Page x:Class="HammerMtheater.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050505">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="0,0,0,40" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="WELCOME TO" 
                               Foreground="#E50914" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Hammer Cinema"
                               FontSize="32"
                               FontWeight="ExtraBold"
                               Foreground="White"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" VerticalAlignment="Center" 
                        Width="45" Height="45" CornerRadius="22" Background="#1A1A1A">
                    <TextBlock Text="👤" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
                </Border>
            </DockPanel>
        </Border>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border Width="300" Height="180"
                    Background="#111111"
                    CornerRadius="12"
                    BorderBrush="#222"
                    BorderThickness="1"
                    Margin="15"
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="NOW SHOWING" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#E50914" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Explore Movies"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Check times and book tickets"
                                   Foreground="#666"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="BROWSE ALL"
                            VerticalAlignment="Bottom"
                            Height="40"
                            Background="#E50914"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="Movies_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Border Width="300" Height="180"
                    Background="#111111"
                    CornerRadius="12"
                    BorderBrush="#222"
                    BorderThickness="1"
                    Margin="15"
                    Padding="25"
                    Opacity="0.7">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="MY ACCOUNT" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="#555" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Your Tickets"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="View your purchase history"
                                   Foreground="#666"
                                   FontSize="13"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Background="#222" 
                            Height="40" 
                            VerticalAlignment="Bottom" 
                            CornerRadius="6">
                        <TextBlock Text="COMING SOON" 
                                   Foreground="#555" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" 
                                   FontWeight="Bold" 
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

        </WrapPanel>
    </Grid>
</Page>