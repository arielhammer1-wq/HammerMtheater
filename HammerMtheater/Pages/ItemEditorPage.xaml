<Page x:Class="HammerMtheater.Pages.ItemEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#141414" Title="Item Editor">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">
            <TextBlock x:Name="PageHeader" Text="Edit Item" FontSize="28" Foreground="White" Margin="0,0,0,30" FontWeight="Bold"/>

            <TextBlock Text="Name / Title" Foreground="Gray" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

            <StackPanel x:Name="MovieFields">
                <TextBlock Text="Length (Minutes)" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtLength" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Age Rating ID" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtAge" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Release Date (yyyy-mm-dd)" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDate" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Genre ID" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtGenre" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Poster URL" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPoster" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Trailer URL" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtTrailer" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>
            </StackPanel>

            <StackPanel x:Name="TheaterFields">
                <TextBlock Text="Address" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtAddress" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="Street Number" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtStreet" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>

                <TextBlock Text="City ID" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCity" Margin="0,0,0,20" FontSize="16" Foreground="White" Background="#333" BorderThickness="0" Padding="5"/>
            </StackPanel>

            <Button x:Name="BtnSave" Content="SAVE TO DATABASE" Click="BtnSave_Click" 
                    Background="#E50914" Height="45" Margin="0,20,0,10" BorderThickness="0" FontWeight="Bold"/>
            <Button Content="CANCEL" Click="BtnCancel_Click" Background="Transparent" Foreground="Gray" BorderThickness="0"/>
        </StackPanel>
    </ScrollViewer>
</Page>