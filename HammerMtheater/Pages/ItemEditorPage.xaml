<Page x:Class="HammerMtheater.Pages.ItemEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11" Title="Item Editor"
      FontFamily="{materialDesign:MaterialDesignFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="60,40">
            <materialDesign:Card Background="#16191E" 
                                 Padding="40" 
                                 UniformCornerRadius="20"
                                 MaxWidth="700"
                                 HorizontalAlignment="Left"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 materialDesign:ShadowAssist.Darken="True">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                        <materialDesign:PackIcon Kind="PencilCircle" Foreground="#00C896" Width="35" Height="35" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageHeader" Text="Edit Item" FontSize="32" Foreground="White" Margin="15,0,0,0" FontWeight="Black"/>
                    </StackPanel>

                    <TextBox x:Name="TxtName" 
                             materialDesign:HintAssist.Hint="Name / Title" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,25" FontSize="16" Foreground="White" 
                             BorderBrush="#252A31"
                             materialDesign:HintAssist.Foreground="#00C896"/>

                    <TextBlock x:Name="LblInfo" Visibility="Collapsed" Height="0"/>
                    <TextBox x:Name="TxtInfo" 
                             Visibility="Collapsed"
                             materialDesign:HintAssist.Hint="Email/Info" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,25" FontSize="16" Foreground="White" 
                             BorderBrush="#252A31"
                             materialDesign:HintAssist.Foreground="#00C896"/>

                    <StackPanel x:Name="MovieFields" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtLength" Grid.Column="0" Margin="0,0,10,25"
                                     materialDesign:HintAssist.Hint="Length (Minutes)" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" BorderBrush="#252A31"/>

                            <TextBox x:Name="TxtAge" Grid.Column="1" Margin="10,0,0,25"
                                     materialDesign:HintAssist.Hint="Age Rating ID" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" BorderBrush="#252A31"/>
                        </Grid>

                        <TextBox x:Name="TxtDate" Margin="0,0,0,25"
                                 materialDesign:HintAssist.Hint="Release Date (yyyy-mm-dd)" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" BorderBrush="#252A31"/>

                        <TextBox x:Name="TxtGenre" Margin="0,0,0,25"
                                 materialDesign:HintAssist.Hint="Genre ID" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" BorderBrush="#252A31"/>

                        <TextBox x:Name="TxtPoster" Margin="0,0,0,25"
                                 materialDesign:HintAssist.Hint="Poster URL" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" BorderBrush="#252A31"/>

                        <TextBox x:Name="TxtTrailer" Margin="0,0,0,25"
                                 materialDesign:HintAssist.Hint="Trailer URL" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" BorderBrush="#252A31"/>
                    </StackPanel>

                    <StackPanel x:Name="TheaterFields" Visibility="Collapsed">
                        <TextBox x:Name="TxtAddress" Margin="0,0,0,25"
                                 materialDesign:HintAssist.Hint="Address" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="White" BorderBrush="#252A31"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtStreet" Grid.Column="0" Margin="0,0,10,25"
                                     materialDesign:HintAssist.Hint="Street Number" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" BorderBrush="#252A31"/>

                            <TextBox x:Name="TxtCity" Grid.Column="1" Margin="10,0,0,25"
                                     materialDesign:HintAssist.Hint="City ID" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Foreground="White" BorderBrush="#252A31"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <Button x:Name="BtnSave" Content="SAVE CHANGES" Click="BtnSave_Click" 
                                Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                Background="#00C896" Foreground="#0B0E11"
                                Height="50" materialDesign:ButtonAssist.CornerRadius="10" 
                                FontWeight="Bold"/>

                        <Button Content="CANCEL" Click="BtnCancel_Click" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#9BA1A6" Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</Page>