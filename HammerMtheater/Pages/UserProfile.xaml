<Page x:Class="HammerMtheater.Pages.UserProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11"
      Title="My Profile">

    <Grid Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,40">
            <Button Command="NavigationCommands.BrowseBack" 
                    Style="{StaticResource MaterialDesignIconButton}" 
                    Foreground="#9BA1A6">
                <materialDesign:PackIcon Kind="ArrowLeft" />
            </Button>
            <TextBlock Text="MY ACCOUNT" VerticalAlignment="Center" 
                       Foreground="#00C896" FontWeight="Black" 
                       FontSize="12" Margin="15,0,0,0"/>
        </DockPanel>

        <materialDesign:Card Grid.Row="1" Background="#16191E" 
                             UniformCornerRadius="20" Padding="30" 
                             Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal">
                <materialDesign:Card Width="80" Height="80" UniformCornerRadius="40" 
                                     Background="#1A00C896">
                    <materialDesign:PackIcon Kind="Account" Width="40" Height="40" 
                                             Foreground="#00C896" HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                </materialDesign:Card>

                <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
                    <TextBlock x:Name="UserNameText" Text="John Doe" 
                               Foreground="White" FontSize="28" FontWeight="Black"/>
                    <TextBlock x:Name="UserEmailText" Text="j.doe@example.com" 
                               Foreground="#555E67" FontSize="14"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" >
                    <Button Content="EDIT PROFILE" Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="#9BA1A6" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ACTIVE BOOKINGS" Foreground="White" 
                       FontWeight="Black" FontSize="16" Margin="0,0,0,20"/>

            <ListBox Grid.Row="1" x:Name="TicketsList" Background="Transparent" 
                     BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden">
            </ListBox>
        </Grid>

        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#CC0B0E11" Grid.RowSpan="3">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             Value="0" IsIndeterminate="True" 
                             Width="50" Height="50" Foreground="#00C896"/>
                <TextBlock Text="Loading your tickets..." Margin="0,20,0,0" 
                           Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>