<Page x:Class="HammerMtheater.Pages.Signup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Sign Up"
      Background="#111">

    <Grid>
        <Border Width="350"
                Padding="30"
                Background="#1E1E1E"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="🎟 Create Account"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Username -->
                <TextBlock Text="Username" Foreground="LightGray"/>
                <TextBox x:Name="SignupUsername"
                         Height="35"
                         Background="#2A2A2A"
                         Foreground="White"
                         Padding="10"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           Foreground="LightGray"
                           Margin="0,15,0,0"/>
                <TextBox x:Name="SignupEmail"
                         Height="35"
                         Background="#2A2A2A"
                         Foreground="White"
                         Padding="10"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           Foreground="LightGray"
                           Margin="0,15,0,0"/>
                <PasswordBox x:Name="SignupPassword"
                             Height="35"
                             Background="#2A2A2A"
                             Foreground="White"
                             Padding="10"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password"
                           Foreground="LightGray"
                           Margin="0,15,0,0"/>
                <PasswordBox x:Name="ConfirmPassword"
                             Height="35"
                             Background="#2A2A2A"
                             Foreground="White"
                             Padding="10"/>

                <!-- Sign Up Button -->
                <Button Content="Sign Up"
                        Height="40"
                        Margin="0,25,0,10"
                        Background="#E50914"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Click="Signup_Click"/>

                <!-- Back to Login -->
                <Button Content="Back to Login"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="LightGray"
                        Cursor="Hand"
                        Click="BackToLogin_Click"
                        HorizontalAlignment="Center"/>

                <!-- Error Message -->
                <TextBlock x:Name="SignupError"
                           Foreground="Red"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
