<Page x:Class="HammerMtheater.Pages.Signup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#050505">

    <Grid>
        <Ellipse Width="600" Height="600"
                 Fill="#12E50914"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-200,-200,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border Width="400"
                Padding="40"
                Background="#161616"
                CornerRadius="15"
                BorderBrush="#333"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <materialDesign:PackIcon Kind="AccountPlus"
                                         Width="45" Height="45"
                                         Foreground="#E50914"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,10"/>

                <TextBlock Text="Join the Experience"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="ExtraBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Create your Hammer Cinema account"
                           Foreground="#666"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBox x:Name="SignupUsername"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Username"
                         Foreground="White"
                         BorderBrush="#444"
                         Margin="0,0,0,16"/>

                <TextBox x:Name="SignupEmail"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Email Address"
                         Foreground="White"
                         BorderBrush="#444"
                         Margin="0,0,0,16"/>

                <PasswordBox x:Name="SignupPassword"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:HintAssist.Hint="Password"
                             Foreground="White"
                             BorderBrush="#444"
                             Margin="0,0,0,16"/>

                <PasswordBox x:Name="ConfirmPassword"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:HintAssist.Hint="Confirm Password"
                             Foreground="White"
                             BorderBrush="#444"
                             Margin="0,0,0,24"/>

                <Button Height="50"
                        Background="#E50914"
                        BorderBrush="#E50914"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="Signup_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="CREATE ACCOUNT"/>
                </Button>

                <TextBlock x:Name="SignupError"
                           Foreground="#FF5252"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"/>

                <Button Content="Already have an account? Sign In"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#999999"
                        FontSize="12"
                        Margin="0,20,0,0"
                        Click="BackToLogin_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>