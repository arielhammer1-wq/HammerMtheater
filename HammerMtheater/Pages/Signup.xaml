<Page x:Class="HammerMtheater.Pages.Signup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#050709"
      Title="Signup">

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.2">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardTransform" Storyboard.TargetProperty="Y" From="50" To="0" Duration="0:0:1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="GlowLeft" Storyboard.TargetProperty="Opacity" From="0" To="0.4" Duration="0:0:2" />
                    <DoubleAnimation Storyboard.TargetName="GlowRight" Storyboard.TargetProperty="Opacity" From="0" To="0.3" Duration="0:0:2.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Ambient Glowing Orbs -->
        <Ellipse x:Name="GlowLeft" Width="800" Height="800" Fill="#7E57C2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-300,0,0" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="200"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse x:Name="GlowRight" Width="700" Height="700" Fill="#00C896" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-200" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="200"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Main Signup Card -->
        <Border x:Name="MainCard" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                Background="#990B0E11" CornerRadius="30" BorderBrush="#3300C896" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="50"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Color="Black" Opacity="0.8"/>
            </Border.Effect>

            <Grid >
                <StackPanel>
                    <!-- Header -->
                    <materialDesign:PackIcon Kind="AccountPlusOutline" Width="50" Height="50" Foreground="#00C896" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Join the Experience" FontSize="32" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="CREATE YOUR CINEMATIC IDENTITY" Foreground="#00C896" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,35" />

                    <!-- Fields -->
                    <TextBox x:Name="SignupUsername" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Username" Margin="0,0,0,18" Foreground="White"
                             BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" Height="55"/>

                    <TextBox x:Name="SignupEmail" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Email Address" Margin="0,0,0,18" Foreground="White"
                             BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" Height="55"/>

                    <!-- Password with Toggle -->
                    <Grid Margin="0,0,0,18">
                        <PasswordBox x:Name="SignupPassword" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="Password" Foreground="White"
                                     BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" Height="55"/>
                        <TextBox x:Name="SignupPasswordVisible" Visibility="Collapsed" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Password" Foreground="White"
                                 BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" Height="55"/>
                        <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="TogglePass_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,5,0">
                            <materialDesign:PackIcon x:Name="EyeIcon" Kind="EyeOutline" Foreground="#9BA1A6"/>
                        </Button>
                    </Grid>

                    <PasswordBox x:Name="ConfirmPassword" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:HintAssist.Hint="Confirm Password" Foreground="White"
                                 BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" Height="55" Margin="0,0,0,25"/>

                    <!-- Action Button -->
                    <Button x:Name="BtnInitialize" Height="55" Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#00C896" Foreground="#050709" 
                            materialDesign:ButtonAssist.CornerRadius="15" Click="Signup_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="INITIALIZE ACCOUNT" VerticalAlignment="Center" FontSize="14" FontWeight="Black"/>
                            <materialDesign:PackIcon Kind="ChevronRight" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="SignupError" Foreground="#FF5252" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                    <Button Content="ALREADY A MEMBER? SIGN IN" Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="#9BA1A6" FontSize="11" FontWeight="Bold" Margin="0,20,0,0" Click="BackToLogin_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>