<Page x:Class="HammerMtheater.Pages.CastPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="CastPage" Background="#0A0A0F">

    <Grid Margin="40">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <Button Click="Back_Click" Content="BACK" Background="#FFC107" BorderBrush="{x:Null}" Foreground="Black"/>
                <TextBlock Text="THE CAST" FontSize="36" FontWeight="Bold" Foreground="White" Margin="20,0,0,0"/>
            </StackPanel>

            <ItemsControl x:Name="ActorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A22" Margin="10" Padding="15" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{Binding ArtistName}" FontSize="18" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ArtistRole.RoleName}" FontSize="14" Foreground="#FFC107"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>