<Page x:Class="HammerMtheater.Pages.SelectTheater"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <Button Content=" BACK" FontFamily="Material Design Icons" 
                    Background="#1AFFFFFF" Foreground="#9BA1A6" 
                    BorderThickness="0" HorizontalAlignment="Left" 
                    Padding="15,0" Height="32" FontSize="11" FontWeight="Bold" 
                    materialDesign:ButtonAssist.CornerRadius="6"
                    Click="Back_Click" Margin="0,0,0,20"/>

            <TextBlock Text="LOCATION SELECTION"
                       FontSize="11"
                       FontWeight="Black"
                     
                       Foreground="#00C896"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Choose your Cinema"
                       FontSize="56"
                       FontWeight="Black"
                       Foreground="White"
                       />
        </StackPanel>

        <ListBox x:Name="TheaterListBox"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,18"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="#16191E"
                                        BorderBrush="#252A31"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="24,20">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentHost"/>
                                        <Ellipse x:Name="SelectionIndicator" 
                                                 Fill="#00C896" 
                                                 Width="8" Height="8" 
                                                 HorizontalAlignment="Right" 
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="10" Color="#00C896" Opacity="0.6" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1C2128"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3F4752"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00C896"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#0D00C896"/>
                                        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" Background="#1AFFFFFF" CornerRadius="12" Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="MapMarkerOutline" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center" Foreground="#00C896" 
                                                   Width="26" Height="26"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NameOfTheater}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Black"
                                      />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <materialDesign:PackIcon Kind="StarOutline" Foreground="#555E67" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Standard &amp; VIP Halls Available" 
                                           Foreground="#9BA1A6" 
                                           FontSize="11" 
                                           FontWeight="Bold"
                                           />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Separator Background="#252A31" Margin="0,0,0,30"/>
            <Button Height="60"
                    Width="320"
                    Content="CONFIRM LOCATION"
                    Background="#00C896"
                    Foreground="#0B0E11"
                    FontSize="14"
                    FontWeight="Black"
                    materialDesign:ButtonAssist.CornerRadius="30"
                    HorizontalAlignment="Center"
                    Click="Continue_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#00C896" Opacity="0.2" ShadowDepth="0"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Page>