<Page x:Class="HammerMtheater.Pages.SelectTheater"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0A">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="LOCATION SELECTION"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#E50914"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Choose your Cinema"
                       FontSize="32"
                       FontWeight="ExtraBold"
                       Foreground="White"/>
            <Button Content="← BACK"
         Width="100"
         Height="35"
         Background="#252525"
         Foreground="#BBBBBB"
         BorderThickness="0"
         HorizontalAlignment="Left"
         FontSize="11"
         FontWeight="Bold"
         Click="Back_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <ListBox x:Name="TheaterListBox"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                        Background="#181818"
                                        BorderBrush="#333"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="20,15">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentHost"/>
                                        <Ellipse x:Name="SelectionIndicator" 
                                                 Fill="#E50914" 
                                                 Width="8" Height="8" 
                                                 HorizontalAlignment="Right" 
                                                 Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#222"/>
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#666"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E50914"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#251010"/>
                                        <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" Background="#333" CornerRadius="20" Margin="0,0,15,0">
                            <TextBlock Text="📍" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NameOfTheater}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Standard &amp; VIP Halls Available" 
                                       Foreground="#666" 
                                       FontSize="11" 
                                       Margin="0,2,0,0"/>
                            
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        

        <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="#222" BorderThickness="0,1,0,0">
            <Button Height="55"
                    Width="280"
                    Content="CONFIRM SELECTION"
                    Background="#E50914"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Click="Continue_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="27"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Border>
    </Grid>
</Page>