<Page x:Class="HammerMtheater.Pages.MyTickets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F">

    <Grid Margin="30">
        <StackPanel>

            <TextBlock Text="My Tickets"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <ListBox x:Name="TicketsList"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0,0,0,12">

                            <StackPanel>
                                <TextBlock Text="{Binding Movie.MovieName}"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Theater.NameOfTheater}"
                                           Foreground="#BBBBBB"/>

                                <TextBlock Text="{Binding Hall.HallName}"
                                           Foreground="#BBBBBB"/>

                                <TextBlock Text="Seat: {Binding SeatNumber}"
                                           Foreground="#BBBBBB"/>

                                <TextBlock Text="₪{Binding TicketPrice}"
                                           Foreground="#E50914"
                                           FontWeight="Bold"/>
                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>
    </Grid>
</Page>
