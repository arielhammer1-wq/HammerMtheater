<Page x:Class="HammerMtheater.Pages.MyTickets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid>
        <Grid Margin="60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,40">
                <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" 
                        Cursor="Hand" Click="Back_Click" Margin="0,0,0,20" Padding="0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Foreground="#00C896" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="BACK TO EXPLORE" Foreground="#9BA1A6" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"  />
                    </StackPanel>
                </Button>

                <TextBlock Text="DIGITAL PASSES" Foreground="#00C896" FontSize="11" FontWeight="Black"  Margin="0,0,0,8"/>
                <TextBlock Text="Your Tickets" FontSize="56" FontWeight="Black" Foreground="White" />
            </StackPanel>

            <ListBox x:Name="TicketsList" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,20"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Background="#16191E" UniformCornerRadius="20" 
                                             materialDesign:ElevationAssist.Elevation="Dp2"
                                             BorderBrush="#252A31" BorderThickness="1">
                            <Grid Height="140">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="35,0">
                                    <TextBlock Text="{Binding Movie.MovieName}" Foreground="White" FontSize="28" FontWeight="Black"/>
                                    <WrapPanel Margin="0,15,0,0">
                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Text="THEATER" Foreground="#555E67" FontSize="9" FontWeight="Black"/>
                                            <TextBlock Text="{Binding Theater.NameOfTheater}" Foreground="#9BA1A6" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="CINEMA HALL" Foreground="#555E67" FontSize="9" FontWeight="Black" />
                                            <TextBlock Text="{Binding Hall.HallName}" Foreground="#9BA1A6" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Fill="#252A31" Margin="0,20" StrokeDashArray="4 4" Stroke="#444" StrokeThickness="2"/>

                                <StackPanel Grid.Column="2" Background="#0D00C896" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Orientation="Vertical">
                                    <StackPanel VerticalAlignment="Center" Margin="0,25,0,0">
                                        <TextBlock Text="SEAT" Foreground="#00C896" FontSize="10" FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SeatNumber}" Foreground="White" FontSize="42" FontWeight="Black" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TicketPrice, StringFormat='₪{0}'}" Foreground="#00C896" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#F20B0E11">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                             Value="0" IsIndeterminate="True" 
                             Width="50" Height="50" Foreground="#00C896" />
                <TextBlock Text="RETRIEVING DIGITAL PASSES" Margin="0,25,0,0" Foreground="#00C896" 
                           FontSize="11" FontWeight="Black"  />
            </StackPanel>
        </Grid>
    </Grid>
</Page>