<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Background="#050505">

    <materialDesign:DialogHost
        Identifier="TrailerDialog"
        CloseOnClickAway="True"
        DialogClosing="DialogHost_DialogClosing">

        <materialDesign:DialogHost.DialogContent>
            <Grid x:Name="TrailerContainer" Width="1100" Height="618" Background="Black">

                <wv2:WebView2
                    x:Name="TrailerBrowser"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

                <Button
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="10"
                    Width="40"
                    Height="40"
                    Background="#66000000"
                    BorderThickness="0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">

                    <materialDesign:PackIcon
                        Kind="Close"
                        Foreground="White"
                        Width="20"
                        Height="20"/>
                </Button>

            </Grid>
        </materialDesign:DialogHost.DialogContent>

        <Grid>

            <Grid>
                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="80"/>
                    </Image.Effect>
                </Image>
                <Border Background="#CC050505"/>
            </Grid>

            <Grid Margin="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="550"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="15"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="60,0,0,0"
                            VerticalAlignment="Top">

                    <Button Content="← GALLERY"
                            Click="Back_Click"
                            Background="Transparent"
                            Foreground="#888"
                            BorderThickness="0"/>

                    <TextBlock Text="{Binding MovieName}"
                               FontSize="64"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,20,0,10"/>

                    <TextBlock Text="{Binding Genre.GenreName}"
                               Foreground="#CCC"
                               Margin="0,0,0,30"/>

                    <StackPanel Orientation="Horizontal">

                        <Button Width="220"
                                Height="60"
                                Background="#E50914"
                                Foreground="White"
                                Click="BuyTicket_Click">
                            GET TICKETS
                        </Button>

                        <Button Content="WATCH TRAILER"
                                Margin="20,0,0,0"
                                Width="180"
                                Height="60"
                                Background="Transparent"
                                Foreground="White"
                                BorderBrush="White"
                                BorderThickness="2"
                                Click="WatchTrailer_Click"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </Grid>

    </materialDesign:DialogHost>
</Page>