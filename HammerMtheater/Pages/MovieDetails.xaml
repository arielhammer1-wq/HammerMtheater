<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#050505">

    <materialDesign:DialogHost Identifier="TrailerDialog" CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <Grid Width="1100" Height="618" Background="Black">
                <MediaElement x:Name="TrailerPlayer" 
                              Stretch="Uniform" 
                              LoadedBehavior="Play" 
                              UnloadedBehavior="Stop"/>

                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="10" Background="#44000000" BorderThickness="0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                    <materialDesign:PackIcon Kind="Close" Foreground="White"/>
                </Button>
            </Grid>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid>
                <Image Source="{Binding PosterUrl}" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="80"/>
                    </Image.Effect>
                </Image>
                <Border Background="#CC050505" />
            </Grid>

            <Grid Margin="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="550"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="825"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Column="0" 
                        VerticalAlignment="Top"
                        CornerRadius="15" 
                        BorderBrush="#44FFFFFF" 
                        BorderThickness="1" 
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" Color="Black" Opacity="0.8" ShadowDepth="0"/>
                    </Border.Effect>
                    <Image Source="{Binding PosterUrl}" Stretch="Fill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="60,0,0,0" VerticalAlignment="Top">

                    <Button Content="← GALLERY" Click="Back_Click"
                            Background="Transparent" Foreground="#888" 
                            BorderThickness="0" HorizontalAlignment="Left"
                            FontSize="12" FontWeight="Bold" Cursor="Hand"/>

                    <TextBlock Text="{Binding MovieName}"
                               FontSize="64" FontWeight="ExtraBold"
                               Foreground="White" TextWrapping="Wrap"
                               Margin="0,20,0,10">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Border Background="#E50914" Padding="10,4" CornerRadius="4">
                            <TextBlock Text="IMAX" Foreground="White" FontSize="12" FontWeight="Black"/>
                        </Border>
                        <TextBlock Text="2024" Foreground="#CCC" Margin="15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="•" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBlock Text="2h 45m" Foreground="#CCC" Margin="15,0" VerticalAlignment="Center"/>
                        <TextBlock Text="•" Foreground="#555" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Genre.GenreName}" Foreground="#CCC" Margin="15,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Experience the ultimate cinematic journey. This premium presentation features expanded aspect ratio, immersive next-generation sound, and crystal clear laser projection."
                               Foreground="#BBB" FontSize="18" LineHeight="28"
                               TextWrapping="Wrap" MaxWidth="650"
                               HorizontalAlignment="Left" Margin="0,0,0,50"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Width="220" Height="60"
                                Background="#E50914" Foreground="White"
                                FontSize="16" FontWeight="Bold" Cursor="Hand"
                                Click="BuyTicket_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="30">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="25" Color="#E50914" Opacity="0.4" ShadowDepth="0"/>
                            </Button.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GET TICKETS" Margin="0,0,10,0"/>
                                <TextBlock Text="🎟️"/>
                            </StackPanel>
                        </Button>

                        <Button Content="WATCH TRAILER" Margin="20,0,0,0"
                                Width="180" Height="60"
                                Background="Transparent" Foreground="White"
                                BorderBrush="White" BorderThickness="2"
                                FontSize="14" FontWeight="Bold"
                                Click="WatchTrailer_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="1.5" CornerRadius="30">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Page>