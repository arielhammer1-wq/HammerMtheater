<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0A0A0A">

    <Grid>
        <Border Opacity="0.4">
            <Border.Background>
                <RadialGradientBrush Center="0.8,0.2" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#22E50914" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    CornerRadius="12" 
                    BorderBrush="#333" 
                    BorderThickness="1" 
                    ClipToBounds="True"
                    Margin="0,0,40,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="10" Opacity="0.6"/>
                </Border.Effect>
                <Image Source="{Binding PosterUrl}" 
                       Stretch="UniformToFill" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <Button Content="← BACK"
                        Width="100"
                        Height="35"
                        Background="#252525"
                        Foreground="#BBBBBB"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        FontWeight="Bold"
                        Click="Back_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="{Binding MovieName}"
                           FontSize="48"
                           FontWeight="ExtraBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,25,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,35">
                    <Border Background="#E50914" Padding="8,3" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="HD" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding Genre.GenreName}"
                               Foreground="#AAAAAA"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Experience the ultimate cinematic journey at HammerM Theater. Premium sound, luxurious seating, and the latest projection technology."
                           Foreground="#777777"
                           FontSize="14"
                           TextWrapping="Wrap"
                           MaxWidth="500"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,40"/>

                <Button Width="240"
                        Height="55"
                        Background="#E50914"
                        Foreground="White"
                        FontSize="18"
                        FontWeight="Bold"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Click="BuyTicket_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="20" Color="#E50914" Opacity="0.3" ShadowDepth="0"/>
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RESERVE SEATS"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Page>