<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- POSTER -->
        <Border CornerRadius="18"
                Background="#1E1E1E"
                Margin="0,0,30,0">
            <Image Source="{Binding PosterUrl}"
                   Stretch="UniformToFill"/>
        </Border>

        <!-- DETAILS -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

            <!-- BACK -->
            <Button Content="← Back"
                    Width="90"
                    Height="32"
                    Background="#1E1E1E"
                    Foreground="White"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    Click="Back_Click"/>

            <!-- TITLE -->
            <TextBlock Text="{Binding MovieName}"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,20,0,10"/>

            <!-- GENRE -->
            <TextBlock Text="{Binding Genre.GenreName}"
                       Foreground="#CCCCCC"
                       FontSize="14"
                       Margin="0,0,0,30"/>

            <!-- BUY -->
            <Button Content="Buy Ticket"
                    Width="220"
                    Height="50"
                    Background="#E50914"
                    Foreground="White"
                    FontSize="16"
                    BorderThickness="0"
                    Click="BuyTicket_Click"/>
        </StackPanel>
    </Grid>
</Page>
