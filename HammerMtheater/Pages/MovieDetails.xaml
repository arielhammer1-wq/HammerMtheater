<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid>
        <materialDesign:DialogHost>
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Back Button -->
                <Button Grid.Row="0" Content="← Back" HorizontalAlignment="Left"
                        Click="Back_Click" Foreground="White"
                        Background="Transparent" BorderThickness="0" FontSize="14"/>

                <!-- Movie Info -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MovieName}" Foreground="White"
                               FontSize="36" FontWeight="Black" Margin="0,0,0,10"/>

                    <TextBlock x:Name="LiveScoreText" Foreground="#00C896"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding Description}" Foreground="#AAAAAA"
                               FontSize="14" TextWrapping="Wrap" Margin="0,0,0,30"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ Watch Trailer" Click="WatchTrailer_Click"
                                Background="#00C896" Foreground="Black"
                                FontWeight="Bold" Padding="20,10"/>
                        <Button Content="🎟 Buy Ticket" Click="BuyTicket_Click"
                                Background="#E50914" Foreground="White"
                                FontWeight="Bold" Padding="20,10"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:DialogHost>

        <!-- Snackbar for notifications -->
        <materialDesign:Snackbar x:Name="MainSnackbar"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,20"/>
    </Grid>
</Page>