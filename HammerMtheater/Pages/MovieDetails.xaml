<Page x:Class="HammerMtheater.Pages.MovieDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:local="clr-namespace:HammerMtheater.Pages"
      Background="#0B0E11">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentEmerald" Color="#00C896"/>
        <SolidColorBrush x:Key="TextMain" Color="White"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9BA1A6"/>
    </Page.Resources>

    <materialDesign:DialogHost Identifier="ShareDialog" CloseOnClickAway="True">
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Margin="30" Width="460">
                <TextBlock Text="SHARE THIS MOVIE" FontSize="11" FontWeight="Black"
                           Foreground="#00C896" Margin="0,0,0,16"/>
                <TextBlock Text="Send movie details to a friend via email."
                           Foreground="#9BA1A6" FontSize="13" Margin="0,0,0,24"/>

                <TextBox x:Name="ShareEmailInput"
                         materialDesign:HintAssist.Hint="friend@example.com"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="White" CaretBrush="White"
                         materialDesign:HintAssist.Foreground="#9BA1A6"
                         BorderBrush="#252A31" Margin="0,0,0,24"
                         FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Height="44" Width="110" Margin="0,0,12,0"
                            Background="Transparent" Foreground="#9BA1A6"
                            BorderBrush="#252A31" BorderThickness="1"
                            FontWeight="Bold" FontSize="12"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="CANCEL"/>
                    <Button Content="SEND" Height="44" Width="110"
                            Background="#00C896" Foreground="#0B0E11"
                            FontWeight="Black" FontSize="12"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="SEND"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <!-- UNIFORM BACKGROUND LAYER (THE ILLUSION) -->
            <Grid>
                <Image Source="{Binding PosterUrl}" 
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Effect>
                        <BlurEffect Radius="80" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <!-- Lighter uniform overlay -->
                <Border Background="#0B0E11" Opacity="0.6"/>
            </Grid>

            <!-- MAIN CONTENT -->
            <Grid Margin="120,60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Navigation Header -->
                <StackPanel Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,40">
                    <Button Click="Back_Click" Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="BACK TO GALLERY" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- LEFT: Movie Information (Expanded since poster is gone) -->
                <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,60,0">
                    <TextBlock Text="{Binding MovieName}" 
                               FontSize="82" FontWeight="Black" 
                               Foreground="{StaticResource TextMain}" 
                               TextWrapping="Wrap" 
                               LineHeight="86" 
                               Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                        <Border Background="#1A00C896" Padding="14,8" CornerRadius="8">
                            <TextBlock Text="{Binding Genre.GenreName}" FontSize="16" 
                                       FontWeight="Bold" Foreground="{StaticResource AccentEmerald}"/>
                        </Border>
                        <TextBlock Text="•" Foreground="{StaticResource TextSecondary}" 
                                   Margin="20,0" VerticalAlignment="Center" FontSize="18"/>
                        <TextBlock Text="{Binding MovieLength, StringFormat='{}{0} min'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="16" 
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="THE CAST" FontSize="13" FontWeight="Black" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />
                    <TextBlock Text="Cast information is being updated." 
                               FontSize="16" Foreground="#9BA1A6" Margin="0,0,0,40"/>

                    <TextBlock Text="SYNOPSIS" FontSize="13" FontWeight="Black" 
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15" />
                    <TextBlock Text="Experience the cinematic event of the year. A gripping narrative that pushes the boundaries of storytelling, featuring award-winning performances and breathtaking visual effects." 
                               FontSize="20" Foreground="White" 
                               TextWrapping="Wrap" LineHeight="32" MaxWidth="800" Opacity="0.95"/>
                </StackPanel>

                <!-- RIGHT: Action Sidebar -->
                <materialDesign:Card Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" 
                                     Padding="30,50" UniformCornerRadius="30" Background="#16191E" 
                                     materialDesign:ElevationAssist.Elevation="Dp12" Opacity="0.98">
                    <StackPanel>
                        <Button x:Name="BtnTickets" Content="GET TICKETS" Height="65" Margin="0,0,0,18"
                                Background="{StaticResource AccentEmerald}" Foreground="#0B0E11"
                                FontWeight="Black" FontSize="16" Click="BuyTicket_Click"
                                materialDesign:ButtonAssist.CornerRadius="15"/>

                        <Button x:Name="BtnTrailer" Content="WATCH TRAILER" Height="65" Margin="0,0,0,30"
                                Background="Transparent" Foreground="White" BorderBrush="#252A31" BorderThickness="1"
                                FontWeight="Bold" FontSize="15" Click="WatchTrailer_Click"
                                materialDesign:ButtonAssist.CornerRadius="15"/>

                        <Separator Background="#252A31" Margin="10,0,10,25"/>

                        <Button Click="ViewCast_Click" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource TextSecondary}" Height="50" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroupOutline" Width="24" Height="24" Margin="0,0,15,0"/>
                                <TextBlock Text="FULL CAST" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Click="Share_Click" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="{StaticResource TextSecondary}" Height="50">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShareVariantOutline" Width="24" Height="24" Margin="0,0,15,0"/>
                                <TextBlock Text="SHARE MOVIE" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Snackbar -->
            <materialDesign:Snackbar x:Name="MainSnackbar"
                                     MessageQueue="{materialDesign:MessageQueue}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,30"/>
        </Grid>
    </materialDesign:DialogHost>
</Page>