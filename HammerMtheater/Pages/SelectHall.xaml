<Page x:Class="HammerMtheater.Pages.SelectHall"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Text="Select Hall"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"/>

        <!-- LIST -->
        <ListBox x:Name="HallListBox"
                 Grid.Row="1"
                 Margin="0,20,0,80"
                 Background="Transparent"
                 BorderThickness="0">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Height="70"
                            Margin="0,0,0,12"
                            Background="#2A2A2A"
                            CornerRadius="12"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="{Binding HallName}"
                                       Foreground="White"
                                       FontSize="18"/>

                            <TextBlock Text="{Binding AmountOfSeats, StringFormat=Seats: {0}}"
                                       Foreground="#AAAAAA"
                                       FontSize="12"/>
                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- CONTINUE -->
        <Button Grid.Row="2"
                Height="48"
                Width="220"
                Content="Continue"
                Background="#E50914"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Click="Continue_Click"/>
    </Grid>
</Page>
