<Page x:Class="HammerMtheater.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0A0A0A">

    <Grid>

        <!-- 🎬 MOVIES BACKGROUND -->
        <ItemsControl x:Name="BackgroundMovies"
                      Opacity="0.35"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding TrailerUrl}"
                           Width="200"
                           Height="300"
                           Stretch="UniformToFill"
                           Margin="2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- DARK OVERLAY -->
        <Border Background="#66000000"/>

        <!-- GLOWS -->
        <Ellipse Width="900" Height="900"
                 Fill="#33E50914"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-350,-350,0"/>

        <Ellipse Width="550" Height="550"
                 Fill="#2200B3FF"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-250,0,0,-250"/>

        <!-- LOGIN CARD -->
        <Border Width="430"
                Padding="38"
                Background="#1A1A1A"
                CornerRadius="20"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- BRAND -->
                <StackPanel Margin="0,0,0,34">
                    <materialDesign:PackIcon Kind="MovieOpen"
                                             Width="50"
                                             Height="50"
                                             Foreground="#E50914"
                                             HorizontalAlignment="Center"/>

                    <TextBlock Text="HammerM Theater"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Premium cinema platform"
                               Foreground="#B0B0B0"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- INPUTS -->
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Username"
                         Margin="0,0,0,16"
                        Foreground="AliceBlue"
                        BorderBrush="AliceBlue"
                         />

                <Grid Margin="0,0,0,16">

                    <!-- PASSWORD FIELD -->
                    <PasswordBox x:Name="PasswordHidden"
                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                 materialDesign:HintAssist.Hint="Password"
                 Padding="0,0,42,0"
                 Foreground="AliceBlue"
                 BorderBrush="AliceBlue" 
                                 />

                    <TextBox x:Name="PasswordVisible"
             Visibility="Collapsed"
             Style="{StaticResource MaterialDesignOutlinedTextBox}"
             materialDesign:HintAssist.Hint="Password"
             Padding="0,0,42,0"
             Foreground="AliceBlue"
             BorderBrush="AliceBlue"
                             Height="50"/>

                    <!-- EYE ICON (OVERLAY) -->
                    <Button Width="60"
            Height="36"
            Background="Transparent"
            BorderThickness="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="286,0,0,0"
            Panel.ZIndex="10"
            Click="TogglePassword_Click">

                        <materialDesign:PackIcon x:Name="EyeIcon"
                                 Kind="Eye"
                                 Width="11"
                                 Height="12"
                                 Foreground="#CCCCCC"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="2.273,0.532" />
                    </Button>

                </Grid>



                <TextBox x:Name="EmailBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Email"
                         Margin="0,0,0,24"
                         Foreground="AliceBlue"
                        BorderBrush="AliceBlue"/>

                <!-- BUTTON -->
                <Button Height="48"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#E50914"
                        Foreground="White"
                        Click="LoginButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Login" Margin="0,0,8,0"/>
                        <TextBlock Text="Sign In"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ErrorText"
                           Foreground="#FF6B6B"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>

                <!-- FOOTER -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">

                    <Button Content="Create account"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="SignupButton_Click"
                            Foreground="AliceBlue"/>

                    <TextBlock Text="  •  " Foreground="#555"/>

                    <Button Content="Skip"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#E50914"
                            Click="skip_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Page>
