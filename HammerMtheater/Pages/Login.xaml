<Page x:Class="HammerMtheater.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid>
        <ItemsControl x:Name="BackgroundMovies"
                      Opacity="0.15"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding TrailerUrl}"
                           Width="200"
                           Height="300"
                           Stretch="UniformToFill"
                           Margin="2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#FF0B0E11" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Ellipse Width="800" Height="800"
                 Fill="#1000C896"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-400,-400,0">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <materialDesign:Card Width="430"
                             Padding="45"
                             Background="#16191E"
                             UniformCornerRadius="25"
                             materialDesign:ElevationAssist.Elevation="Dp6"
                             materialDesign:ShadowAssist.Darken="True"
                             materialDesign:ShadowAssist.CacheMode="BitmapCache"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">

            <StackPanel>
                <StackPanel Margin="0,0,0,40">
                    <materialDesign:PackIcon Kind="MovieFilter"
                                             Width="60"
                                             Height="60"
                                             Foreground="#00C896"
                                             HorizontalAlignment="Center"/>

                    <TextBlock Text="HammerM Theater"
                               FontSize="34"
                               FontWeight="Black"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"/>

                    <TextBlock Text="PREMIUM CINEMA PLATFORM"
                               Foreground="#9BA1A6"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Username"
                         Margin="0,0,0,16"
                         Foreground="White"
                         BorderBrush="#252A31"
                         materialDesign:HintAssist.Foreground="#00C896"/>

                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="PasswordHidden"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:HintAssist.Hint="Password"
                                 Padding="0,0,45,0"
                                 Foreground="White"
                                 BorderBrush="#252A31"
                                 materialDesign:HintAssist.Foreground="#00C896"/>

                    <TextBox x:Name="PasswordVisible"
                             Visibility="Collapsed"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Password"
                             Padding="0,0,45,0"
                             Foreground="White"
                             BorderBrush="#252A31"
                             Height="50"/>

                    <Button Width="40"
                            Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Panel.ZIndex="10"
                            Click="TogglePassword_Click">
                        <materialDesign:PackIcon x:Name="EyeIcon"
                                                 Kind="Eye"
                                                 Width="22"
                                                 Height="22"
                                                 Foreground="#9BA1A6"/>
                    </Button>
                </Grid>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Email Address"
                         Margin="0,0,0,24"
                         Foreground="White"
                         BorderBrush="#252A31"
                         materialDesign:HintAssist.Foreground="#00C896"/>

                <Button Height="55"
                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Background="#00C896"
                        Foreground="#0B0E11"
                        FontWeight="Bold"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        Click="LoginButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LoginVariant" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SIGN IN" VerticalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ErrorText"
                           Foreground="#FF5252"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">

                    <Button Content="Create account"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="SignupButton_Click"
                            Foreground="#9BA1A6"
                            FontSize="12"/>

                    <TextBlock Text="|" Foreground="#252A31" VerticalAlignment="Center" Margin="8,0"/>

                    <Button Content="Admin Mode"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="skip_Click_admin"
                            Foreground="#00C896"
                            FontWeight="Bold"
                            FontSize="12"/>

                    <Button Content="Guest Mode"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="skip_Click_user"
                            Foreground="#9BA1A6"
                            FontWeight="Bold"
                            FontSize="12"/>
                </StackPanel>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page>