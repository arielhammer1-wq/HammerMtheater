<Page x:Class="HammerMtheater.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#050709"
      Title="Login">

    <Page.Triggers>
        <!-- Stunning Entry Animation -->
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.2">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardTransform" Storyboard.TargetProperty="Y" From="50" To="0" Duration="0:0:1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Glow1" Storyboard.TargetProperty="Opacity" From="0" To="0.6" Duration="0:0:2" />
                    <DoubleAnimation Storyboard.TargetName="Glow2" Storyboard.TargetProperty="Opacity" From="0" To="0.4" Duration="0:0:2.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid>
        <!-- Background Movies Grid (Kept your logic, darkened for better contrast) -->
        <ItemsControl x:Name="BackgroundMovies" Opacity="0.08" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding TrailerUrl}" Width="200" Height="300" Stretch="UniformToFill" Margin="2"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ambient Glowing Orbs -->
        <Ellipse x:Name="Glow1" Width="900" Height="900" Fill="#00C896" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-400,-300,0" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="250"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse x:Name="Glow2" Width="800" Height="800" Fill="#7E57C2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-300" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="250"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Deep Gradient Overlay -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1.2" RadiusY="1.2">
                    <GradientStop Color="#40050709" Offset="0" />
                    <GradientStop Color="#FF050709" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Login Card -->
        <Border x:Name="MainCard" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                Background="#990B0E11" CornerRadius="30" BorderBrush="#3300C896" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" Y="50"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Color="Black" Opacity="0.8"/>
            </Border.Effect>

            <Grid >
                <StackPanel>

                    <!-- Header Section -->
                    <StackPanel Margin="0,0,0,45">
                        <Border Background="#1A00C896" Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <materialDesign:PackIcon Kind="MovieOpenPlayOutline" Width="45" Height="45" Foreground="#00C896" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="HammerM Theater" FontSize="36" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI" />
                        <TextBlock Text="PREMIUM CINEMA EXPERIENCE" Foreground="#00C896" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Input Fields -->
                    <TextBox x:Name="UsernameBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Username" Margin="0,0,0,20" Foreground="White"
                             BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6"
                             materialDesign:TextFieldAssist.HasClearButton="True" FontSize="15" Height="55" Padding="15,0,0,0"/>

                    <TextBox x:Name="EmailBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Email Address" Margin="0,0,0,20" Foreground="White"
                             BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6"
                             materialDesign:TextFieldAssist.HasClearButton="True" FontSize="15" Height="55" Padding="15,0,0,0"/>

                    <Grid Margin="0,0,0,25">
                        <PasswordBox x:Name="PasswordHidden" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     materialDesign:HintAssist.Hint="Password" Padding="15,0,55,0" Foreground="White"
                                     BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" FontSize="15" Height="55"/>

                        <TextBox x:Name="PasswordVisible" Visibility="Collapsed" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Password" Padding="15,0,55,0" Foreground="White"
                                 BorderBrush="#252A31" materialDesign:HintAssist.Foreground="#9BA1A6" FontSize="15" Height="55"/>

                        <Button Width="45" Height="45" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Panel.ZIndex="10" Click="TogglePassword_Click" Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon x:Name="EyeIcon" Kind="EyeOutline" Width="24" Height="24" Foreground="#9BA1A6"/>
                        </Button>
                    </Grid>

                    <!-- Error Text -->
                    <TextBlock x:Name="ErrorText" Foreground="#FF5252" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-10,0,15"/>

                    <!-- Main Button -->
                    <Button Height="60" Style="{StaticResource MaterialDesignFlatMidBgButton}" Background="#00C896" Foreground="#050709" materialDesign:ButtonAssist.CornerRadius="15" Click="LoginButton_Click" Cursor="Hand">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#00E6AD" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)" To="#00C896" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ACCESS PLATFORM" VerticalAlignment="Center" FontSize="16" FontWeight="Black"/>
                            <materialDesign:PackIcon Kind="ArrowRight" Margin="10,0,0,0" VerticalAlignment="Center" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <!-- Bottom Links -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,35,0,0">
                        <Button Content="CREATE ACCOUNT" Style="{StaticResource MaterialDesignFlatButton}" Click="SignupButton_Click" Foreground="#9BA1A6" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="•" Foreground="#444" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Content="GUEST" Style="{StaticResource MaterialDesignFlatButton}" Click="skip_Click_user" Foreground="#9BA1A6" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="•" Foreground="#444" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Content="ADMIN" Style="{StaticResource MaterialDesignFlatButton}" Click="skip_Click_admin" Foreground="#00C896" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>