<Page x:Class="HammerMtheater.Pages.SeatSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#050505">

    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="HAMMER M-THEATER" Foreground="#E50914" FontSize="12" 
                       FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Select Your Seats" FontSize="32" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,80">
            <Path Data="M 0,40 Q 400,0 800,40" Stroke="#22E50914" StrokeThickness="40" Opacity="0.5">
                <Path.Effect>
                    <BlurEffect Radius="50"/>
                </Path.Effect>
            </Path>
            <Path Data="M 0,40 Q 400,0 800,40" Stroke="White" StrokeThickness="3">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="10" Color="White" Opacity="0.5" ShadowDepth="0"/>
                </Path.Effect>
            </Path>
            <TextBlock Text="SCREEN" Foreground="#444" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UniformGrid x:Name="LeftSeats" Grid.Column="0" Columns="3" VerticalAlignment="Top"/>
                <UniformGrid x:Name="CenterSeats" Grid.Column="2" Columns="10" VerticalAlignment="Top"/>
                <UniformGrid x:Name="RightSeats" Grid.Column="4" Columns="3" VerticalAlignment="Top"/>

                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95"/>
                        <SkewTransform AngleX="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="4" Background="#111" CornerRadius="20" Padding="30,15" Margin="0,20,0,0" BorderBrush="#222" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                        <Border Width="18" Height="18" Background="#2A2A2A" CornerRadius="4" Margin="0,0,10,0"/>
                        <TextBlock Text="Available" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                        <Border Width="18" Height="18" Background="#E50914" CornerRadius="4" Margin="0,0,10,0"/>
                        <TextBlock Text="Selected" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18" Height="18" Background="#080808" BorderBrush="#333" 
                                BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"/>
                        <TextBlock Text="Occupied" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="CONFIRM SEATS" 
                        Width="200" Height="45" Background="#E50914" 
                        Foreground="White" FontWeight="Bold" Click="Continue_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Button Grid.Row="0" Content="←" Background="Transparent" Foreground="#555" 
                BorderThickness="0" HorizontalAlignment="Left" FontSize="20" Click="Back_Click"/>
    </Grid>
</Page>