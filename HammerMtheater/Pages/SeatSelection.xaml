<Page x:Class="HammerMtheater.Pages.SeatSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:HammerMtheater.UserControls"
      Background="#0F0F0F">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select Seat"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"/>

        <ScrollViewer Grid.Row="1" Margin="0,20">
            <UniformGrid x:Name="SeatsGrid"
                         Columns="10"/>
        </ScrollViewer>

        <Button Grid.Row="2"
                Height="48"
                Width="220"
                Content="Continue"
                Background="#E50914"
                Foreground="White"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Click="Continue_Click"/>
    </Grid>
</Page>
