<Page x:Class="HammerMtheater.Pages.SeatSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uc="clr-namespace:HammerMtheater.UserControls"
      Background="#050505">

    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="SEATING PLAN" 
                       Foreground="#E50914" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <TextBlock Text="Pick Your Best View"
                       FontSize="28"
                       FontWeight="ExtraBold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,60" Width="600">
            <Path Data="M 0,20 Q 300,0 600,20" 
                  Stroke="#44E50914" 
                  StrokeThickness="4" 
                  HorizontalAlignment="Center">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#E50914" Opacity="0.6" ShadowDepth="0"/>
                </Path.Effect>
            </Path>
            <TextBlock Text="SCREEN" 
                       Foreground="#444" 
                       FontSize="10" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom"
                       Margin="0,25,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Hidden" 
                      HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center">
                <Border BorderBrush="#151515" BorderThickness="2" Padding="20" CornerRadius="10">
                    <UniformGrid x:Name="SeatsGrid"
                                 Columns="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"/>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20">
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <Rectangle Width="15" Height="15" Fill="#2A2A2A" RadiusX="3" RadiusY="3" Margin="0,0,8,0"/>
                <TextBlock Text="Available" Foreground="#888" FontSize="11"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <Rectangle Width="15" Height="15" Fill="#E50914" RadiusX="3" RadiusY="3" Margin="0,0,8,0"/>
                <TextBlock Text="Selected" Foreground="#888" FontSize="11"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <Rectangle Width="15" Height="15" Fill="#000" Stroke="#333" RadiusX="3" RadiusY="3" Margin="0,0,8,0"/>
                <TextBlock Text="Occupied" Foreground="#888" FontSize="11"/>
            </StackPanel>
        </StackPanel>
        <Button Content="← BACK"
         Width="100"
         Height="35"
         Background="#252525"
         Foreground="#BBBBBB"
         BorderThickness="0"
         HorizontalAlignment="Left"
         FontSize="11"
         FontWeight="Bold"
         Click="Back_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
        </Button>

        <Button Grid.Row="4"
                Height="55"
                Width="260"
                Content="CONFIRM SEATS"
                Background="#E50914"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Click="Continue_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Page>