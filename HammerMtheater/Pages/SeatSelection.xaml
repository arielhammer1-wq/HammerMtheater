<Page x:Class="HammerMtheater.Pages.SeatSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="#0B0E11">

    <Grid Margin="60,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Button Content="" FontFamily="Material Design Icons" Background="Transparent" 
                    Foreground="#555E67" BorderThickness="0" HorizontalAlignment="Left" 
                    FontSize="24" Click="Back_Click"/>

            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="HAMMER M-THEATER" Foreground="#00C896" FontSize="11" 
                           FontWeight="Black" HorizontalAlignment="Center" />
                <TextBlock Text="Select Your Seats" FontSize="42" FontWeight="Black" 
                           Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,80">
            <Path Data="M 0,50 Q 450,0 900,50" Stroke="#1500C896" StrokeThickness="60" Opacity="0.6">
                <Path.Effect>
                    <BlurEffect Radius="60"/>
                </Path.Effect>
            </Path>
            <Path Data="M 0,50 Q 450,0 900,50" Stroke="#00C896" StrokeThickness="3">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#00C896" Opacity="0.6" ShadowDepth="0"/>
                </Path.Effect>
            </Path>
            <TextBlock Text="DIGITAL CURVED SCREEN" Foreground="#252A31" FontSize="10" 
                       FontWeight="Black" HorizontalAlignment="Center" 
                       VerticalAlignment="Top" Margin="0,65,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <UniformGrid x:Name="LeftSeats" Grid.Column="0" Columns="3" VerticalAlignment="Top"/>
                <UniformGrid x:Name="CenterSeats" Grid.Column="2" Columns="10" VerticalAlignment="Top"/>
                <UniformGrid x:Name="RightSeats" Grid.Column="4" Columns="3" VerticalAlignment="Top"/>

                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.98"/>
                        <SkewTransform AngleX="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
            </Grid>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="4" Background="#16191E" UniformCornerRadius="25" 
                             Padding="40,20" Margin="0,30,0,0" BorderBrush="#252A31" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,35,0">
                        <Border Width="16" Height="16" Background="#252A31" CornerRadius="4" Margin="0,0,12,0"/>
                        <TextBlock Text="Available" Foreground="#9BA1A6" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,35,0">
                        <Border Width="16" Height="16" Background="#00C896" CornerRadius="4" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#00C896" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="Selected" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" Background="#0B0E11" BorderBrush="#252A31" 
                                BorderThickness="1" CornerRadius="4" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Close" Foreground="#252A31" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Reserved" Foreground="#555E67" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="PROCEED TO CHECKOUT" 
                        Width="240" Height="50" Background="#00C896" 
                        Foreground="#0B0E11" FontWeight="Black" FontSize="14"
                        materialDesign:ButtonAssist.CornerRadius="12"
                        Click="Continue_Click"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>