    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Model">
      <HintPath>..\..\Arielproject222\MoviesInterface\bin\Debug\net8.0\Model.dll</HintPath>
    </Reference>
    <Reference Include="MoviesInterface">
      <HintPath>..\..\Arielproject222\MoviesInterface\bin\Debug\net8.0\MoviesInterface.dll</HintPath>
    </Reference>
  </ItemGroup>

