    <UserControl x:Class="HammerMtheater.UserControls.MovieCard"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 Height="300"
                 Width="200">

        <Border CornerRadius="14"
                Background="#1E1E1E"
                Margin="8"
                Cursor="Hand"
                MouseLeftButtonUp="Card_Click">

            <Grid>

                <!-- POSTER -->
                <Image Source="{Binding PosterUrl}"
                       Stretch="UniformToFill"/>

                <!-- GRADIENT OVERLAY -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#CC000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- TEXT -->
                <StackPanel VerticalAlignment="Bottom"
                            Margin="10">
                    <TextBlock Text="{Binding MovieName}"
                               Foreground="White"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding Genre.GenreName}"
                               Foreground="#CCCCCC"
                               FontSize="11"/>
                </StackPanel>

            </Grid>
        </Border>
    </UserControl>
