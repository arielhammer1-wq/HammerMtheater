<UserControl x:Class="HammerMtheater.UserControls.MovieCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="320"
             Width="210">

    <Border x:Name="MainBorder" 
            CornerRadius="16"
            Background="#1E1E1E"
            Margin="8"
            Cursor="Hand"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            ClipToBounds="True"
            MouseLeftButtonUp="Card_Click">

        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#E50914"/>
                        <Setter Property="Background" Value="#2A2A2A"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Background="Black" 
                                    CornerRadius="16" 
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <Image Source="{Binding PosterUrl}"
                       Stretch="Fill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                </Image>
            </Grid>

            <Border CornerRadius="16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0.3">
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel VerticalAlignment="Bottom" Margin="15,15,15,12">
                <TextBlock Text="{Binding MovieName}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="ExtraBold"
                           TextWrapping="Wrap"
                           MaxHeight="45"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border Background="#E50914" CornerRadius="3" Padding="4,1" Margin="0,0,8,0">
                        <TextBlock Text="HD" Foreground="White" FontSize="9" FontWeight="Black"/>
                    </Border>
                    <TextBlock Text="{Binding Genre.GenreName}"
                               Foreground="#AAAAAA"
                               FontSize="11"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>