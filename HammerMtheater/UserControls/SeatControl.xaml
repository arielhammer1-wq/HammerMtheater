<UserControl x:Class="HammerMtheater.UserControls.SeatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="42"
             Width="42">

    <Border x:Name="Root"
            CornerRadius="6"
            Background="#4CAF50"
            Cursor="Hand"
            MouseLeftButtonUp="Seat_Click">

        <TextBlock x:Name="SeatText"
                   Foreground="White"
                   FontSize="12"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
