<UserControl x:Class="HammerMtheater.UserControls.SeatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50"
             Height="50"
             MouseLeftButtonUp="Seat_Click">

    <Grid x:Name="Root" Background="Transparent">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <Border x:Name="Backrest"
                    Width="36"
                    Height="18"
                    CornerRadius="6,6,0,0"
                    Background="#252A31"/>

            <Border x:Name="SeatCushion"
                    Width="40"
                    Height="20"
                    CornerRadius="4"
                    Background="#252A31"/>

            <TextBlock x:Name="SeatText"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>