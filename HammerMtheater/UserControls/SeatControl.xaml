<UserControl x:Class="HammerMtheater.UserControls.SeatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50" Height="50"
             MouseLeftButtonUp="Seat_Click">

    <Grid x:Name="Root">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >

            <!-- Backrest -->
            <Border x:Name="Backrest"
                    Width="36" Height="18"
                    CornerRadius="6,6,0,0"
                    Background="#2A2A2A"/>

            <!-- Seat Cushion -->
            <Border x:Name="SeatCushion"
                    Width="40" Height="20"
                    CornerRadius="4"
                    Background="#2A2A2A"/>

            <!-- Seat Number -->
            <TextBlock x:Name="SeatText"
                       HorizontalAlignment="Center"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>